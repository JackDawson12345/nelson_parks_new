<div data-controller="modal">
  <div class="mb-6 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-semibold text-[#17261f]">
        Utilities
      </h1>

      <p class="text-sm/[20px] text-[#17261f80]">
        Track utilities by park and year
      </p>
    </div>

    <button
      type="button"
      data-action="click->modal#open"
      data-modal-id="utility-modal"
      class="bg-[#ffc029] py-2 px-4 rounded flex gap-2 items-center hover:bg-[#ffc029] transition"
    >
      <%= render 'icons/plus', size: '16px', colour: '#181818' %>

      <p class="text-[#181818] text-sm font-medium">
        Add Utility
      </p>
    </button>
  </div>

  <%= render "form", utility: @utility %>

  <%= turbo_frame_tag "utilities" do %>
    <%= render "utilities", utilities: @utilities %>
  <% end %>
</div>