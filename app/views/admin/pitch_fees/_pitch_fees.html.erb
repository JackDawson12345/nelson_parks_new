<%= form_with url: admin_pitch_fees_path,
              method: :get,
              data: { turbo_frame: "pitch_fees" },
              class: "flex justify-between mb-6 w-full" do %>
  <div class="flex gap-5">
    <div class="flex gap-2 items-center">
      <p>Park:</p>

      <select name="park" class="py-1.5 px-3 border rounded bg-transparent" onchange="this.form.requestSubmit()">
        <option value="">All Parks</option>

        <% @parks.each do |park| %>
          <option value="<%= park.id %>" <%= "selected" if params[:park] == park.id.to_s %>>
            <%= park.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="flex gap-2 items-center">
      <p>Year:</p>

      <select name="year" class="py-1.5 px-3 border rounded bg-transparent" onchange="this.form.requestSubmit()">
        <% @years.sort.reverse.each do |year| %>
          <option value="<%= year %>" <%= "selected" if @selected_year.to_s == year.to_s %>>
            <%= year %>
          </option>
        <% end %>
      </select>
    </div>
  </div>

  <div class="flex items-center">
    <p><%= pitch_fees.total_entries %> Pitch Fees</p>
  </div>
<% end %>

<div>
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-white">
    <tr>
      <th class="px-4 h-12 text-left text-sm font-medium text-[#17261f80]">Client</th>
      <th class="px-4 h-12 text-left text-sm font-medium text-[#17261f80]">Park</th>
      <th class="px-4 h-12 text-left text-sm font-medium text-[#17261f80]">Pitch</th>
      <th class="px-4 h-12 text-left text-sm font-medium text-[#17261f80]">Year</th>
      <th class="px-4 h-12 text-left text-sm font-medium text-[#17261f80]">Frequency</th>
      <th class="px-4 h-12 text-right text-sm font-medium text-[#17261f80]">VAT %</th>
      <th class="px-4 h-12 text-right text-sm font-medium text-[#17261f80]">Net</th>
      <th class="px-4 h-12 text-right text-sm font-medium text-[#17261f80]">VAT</th>
      <th class="px-4 h-12 text-right text-sm font-medium text-[#17261f80]">Total</th>
      <th class="px-4 h-12 text-right text-sm font-medium text-[#17261f80]">Actions</th>
    </tr>
    </thead>

    <tbody class="divide-y divide-gray-200 bg-white">
    <% pitch_fees.each do |pitch_fee| %>
      <tr>
        <td class="px-4 py-3 text-sm text-gray-700 font-medium">
          <%= pitch_fee.user.full_name %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700">
          <%= pitch_fee.park.name %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700">
          <%= pitch_fee.pitch.pitch_number %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700">
          <%= pitch_fee.year %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700">
          <%= pitch_fee.frequency %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700 text-right">
          <%= number_to_percentage(pitch_fee.vat, precision: 2) %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700 text-right">
          <%= number_to_currency(pitch_fee.net_total, unit: "£") %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700 text-right">
          <%= number_to_currency(pitch_fee.vat_total, unit: "£") %>
        </td>

        <td class="px-4 py-3 text-sm text-gray-700 text-right font-medium">
          <%= number_to_currency(pitch_fee.total, unit: "£") %>
        </td>

        <td class="px-4 py-3">
          <div class="flex justify-end items-center gap-4">
            <button
              type="button"
              data-action="click->modal#open"
              data-modal-id="edit-pitch-fee-<%= pitch_fee.id %>"
              class="w-8 h-8 flex justify-center items-center rounded hover:bg-[#f5f5f5]"
            >
              <%= edit_icon %>
            </button>

            <button
              type="button"
              data-action="click->modal#open"
              data-modal-id="delete-pitch-fee-<%= pitch_fee.id %>"
              class="w-8 h-8 flex justify-center items-center rounded hover:bg-[#fef2f2]"
            >
              <%= bin_icon %>
            </button>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>

<% if pitch_fees.total_pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%= will_paginate pitch_fees,
                      renderer: WillPaginateTurboHelper::TurboLinkRenderer,
                      params: request.query_parameters.except(:page)
    %>
  </div>
<% end %>

<% pitch_fees.each do |pitch_fee| %>
  <%= render "form", pitch_fee: pitch_fee %>

  <div
    id="delete-pitch-fee-<%= pitch_fee.id %>"
    data-modal
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4"
  >
    <div
      class="absolute inset-0"
      data-action="click->modal#close"
    ></div>

    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
      <div class="mb-6">
        <h2 class="text-xl font-semibold text-[#17261f]">
          Delete Pitch Fee
        </h2>

        <p class="text-sm text-[#17261f80] mt-2">
          Are you sure you want to delete this pitch fee for
          <span class="font-semibold text-[#17261f]">
            <%= pitch_fee.user.full_name %>
          </span>
          on pitch
          <span class="font-semibold text-[#17261f]">
            <%= pitch_fee.pitch.pitch_number %>
          </span>?
        </p>
      </div>

      <div class="flex justify-end gap-3">
        <button
          type="button"
          data-action="click->modal#close"
          class="rounded border px-4 py-2 text-sm"
        >
          Cancel
        </button>

        <%= button_to "Delete",
                      admin_pitch_fee_path(pitch_fee),
                      method: :delete,
                      data: { turbo: false },
                      class: "bg-[#db2424] text-white py-2 px-4 rounded text-sm font-medium hover:bg-[#b91c1c]" %>
      </div>
    </div>
  </div>
<% end %>