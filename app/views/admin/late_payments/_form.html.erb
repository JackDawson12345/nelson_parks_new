<% modal_id = late_payment.persisted? ? "edit-late-payment-#{late_payment.id}" : "late-payment-modal" %>

<% display_net_total = late_payment.net_total %>

<% standard_vat_values = [5.to_d, 10.to_d, 20.to_d] %>

<% vat_value =
     if late_payment.vat.present? && standard_vat_values.include?(late_payment.vat.to_d)
       late_payment.vat.to_i.to_s
     elsif late_payment.vat.present?
       "custom"
     else
       ""
     end
%>

<% custom_vat_value = vat_value == "custom" ? late_payment.vat : nil %>

<div
  id="<%= modal_id %>"
  data-modal
  class="hidden fixed inset-0 z-50 bg-black/60 flex items-center justify-center"
>
  <div class="bg-white rounded-lg w-full max-w-md p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-semibold text-[#17261f]">
        <%= late_payment.persisted? ? "Edit Late Payment" : "Add Late Payment" %>
      </h2>

      <button
        type="button"
        data-action="click->modal#close"
        class="text-[#17261f80] hover:text-[#17261f]"
      >
        ✕
      </button>
    </div>

    <%= form_with model: [:admin, late_payment],
                  class: "space-y-4",
                  data: {
                    controller: "vat",
                    turbo: false
                  } do |form| %>

      <div class="flex flex-col gap-4">
        <div>
          <%= form.label :pitch_id, "Pitch", class: "block text-sm mb-1" %>

          <%= form.select :pitch_id,
                          @pitches.map { |pitch|
                            [
                              "#{pitch.park.name} - #{pitch.pitch_number} - #{pitch.user.full_name}",
                              pitch.id
                            ]
                          },
                          { prompt: "Select Pitch" },
                          class: "w-full rounded border px-3 py-2"
          %>
        </div>

        <div>
          <%= form.label :net_total, "Amount (£)", class: "block text-sm mb-1" %>

          <%= form.number_field :net_total,
                                value: display_net_total,
                                step: "0.01",
                                class: "w-full rounded border px-3 py-2",
                                data: {
                                  vat_target: "amount",
                                  action: "input->vat#calculate"
                                }
          %>
        </div>

        <div>
          <%= form.label :due_date, class: "block text-sm mb-1" %>

          <%= form.date_field :due_date,
                              class: "w-full rounded border px-3 py-2" %>
        </div>

        <div class="flex gap-4">
          <div class="w-1/2">
            <%= label_tag :vat_select, "VAT", class: "block text-sm mb-1" %>

            <%= select_tag :vat_select,
                           options_for_select(
                             [
                               ["Select VAT", ""],
                               ["5%", "5"],
                               ["10%", "10"],
                               ["20%", "20"],
                               ["Custom", "custom"]
                             ],
                             vat_value
                           ),
                           class: "w-full rounded border px-3 py-2",
                           data: {
                             vat_target: "select",
                             action: "change->vat#toggle"
                           }
            %>
          </div>

          <div
            class="w-1/2 <%= vat_value == 'custom' ? '' : 'hidden' %>"
            data-vat-target="customContainer"
          >
            <%= label_tag :custom_vat, "Custom VAT %", class: "block text-sm mb-1" %>

            <%= number_field_tag :custom_vat,
                                 custom_vat_value,
                                 min: 0,
                                 max: 100,
                                 step: 0.01,
                                 placeholder: "0-100",
                                 class: "w-full rounded border px-3 py-2",
                                 disabled: vat_value != "custom",
                                 data: {
                                   vat_target: "custom",
                                   action: "input->vat#calculate"
                                 }
            %>
          </div>
        </div>
      </div>

      <div class="border p-3 rounded flex flex-col gap-1">
        <div class="flex justify-between">
          <p class="text-sm text-[#17261f80]">Net</p>
          <p class="text-sm font-medium text-[#17261f]" data-vat-target="net">
            £0.00
          </p>
        </div>

        <div class="flex justify-between">
          <p class="text-sm text-[#17261f80]" data-vat-target="vatLabel">
            Vat (0%)
          </p>

          <p class="text-sm font-medium text-[#17261f]" data-vat-target="vatTotal">
            £0.00
          </p>
        </div>

        <div class="border-t pt-2 mt-2 flex justify-between">
          <p class="text-sm font-semibold text-[#17261f]">Total</p>

          <p class="text-sm font-semibold text-[#17261f]" data-vat-target="total">
            £0.00
          </p>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4">
        <button
          type="button"
          data-action="click->modal#close"
          class="px-4 py-2 rounded border"
        >
          Cancel
        </button>

        <%= form.submit late_payment.persisted? ? "Update Late Payment" : "Add Late Payment",
                        class: "bg-[#ffb400] text-[#181818] px-4 py-2 rounded hover:bg-[#ffc029] transition"
        %>
      </div>
    <% end %>
  </div>
</div>