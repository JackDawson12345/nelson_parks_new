<div data-controller="modal">
  <div class="mb-6 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-semibold text-[#17261f]">
        Exports
      </h1>

      <p class="text-sm/[20px] text-[#17261f80]">
        Download data exports for accounting and reporting
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-4">
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Clients Export</h4>
            <p class="text-sm/[20px]">All client records with balances</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg">
            <%= link_to admin_clients_export_path, class: 'flex items-center gap-2' do %>
              <%= render 'icons/exports', size: '16px', colour: '#181818' %> Download
            <% end %>
          </button>
        </div>
      </div>
    </div>
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Meter Reading Export</h4>
            <p class="text-sm/[20px]">Filter by park and date range</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button
            type="button"
            data-action="click->modal#open"
            data-modal-id="meter-reading-export-modal"
            class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg"
          >
            <%= render 'icons/exports', size: '16px', colour: '#181818' %> Download
          </button>
        </div>
      </div>
    </div>
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Pitch Fees Export</h4>
            <p class="text-sm/[20px]">Filter by park and date range</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button
            type="button"
            data-action="click->modal#open"
            data-modal-id="pitch-fees-export-modal"
            class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg"
          >
            <%= render 'icons/exports', size: '16px', colour: '#181818' %> Download
          </button>
        </div>
      </div>
    </div>
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Utilities Export</h4>
            <p class="text-sm/[20px]">Filter by park and date range</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg">
            <%= render 'icons/exports', size: '16px', colour: '#181818' %>
            Download
          </button>
        </div>
      </div>
    </div>
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Late Payments Export</h4>
            <p class="text-sm/[20px]">Filter by park and date range</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg">
            <%= render 'icons/exports', size: '16px', colour: '#181818' %>
            Download
          </button>
        </div>
      </div>
    </div>
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Lodge Payments Export</h4>
            <p class="text-sm/[20px]">Filter by park and date range</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg">
            <%= render 'icons/exports', size: '16px', colour: '#181818' %>
            Download
          </button>
        </div>
      </div>
    </div>
    <div class="bg-white shadow-sm p-5 flex flex-col gap-4 border rounded-lg hover:border-[#ffb400] transition duration-500 ease-in-out">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded bg-[#ffb40020] flex items-center justify-center">
            <%= render 'icons/invoices', size: '24px', colour: '#ffb400' %>
          </div>
          <div>
            <h4 class="font-semibold">Invoice Exports</h4>
            <p class="text-sm/[20px]">Filter by date range</p>
            <p class="text-xs/[16px] text-[#ffb400]">CSV</p>
          </div>
        </div>
        <div>
          <button class="px-3 py-1 flex gap-2 items-center justify-center border rounded-lg">
            <%= render 'icons/exports', size: '16px', colour: '#181818' %>
            Download
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Meter Reading Export Modal -->
  <div
    id="meter-reading-export-modal"
    data-modal
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4"
  >
    <div class="absolute inset-0" data-action="click->modal#close"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-lg p-6">
      <div class="flex justify-between items-start mb-3">
        <div>
          <h2 class="text-xl font-semibold text-[#17261f]">
            Meter Reading Export
          </h2>
        </div>

        <button
          type="button"
          data-action="click->modal#close"
          class="w-8 h-8 flex items-center justify-center rounded hover:bg-[#f3f4f6]"
        >
          <span class="text-[#17261f80] text-lg leading-none">×</span>
        </button>
      </div>

      <!-- Meter Reading Export Form -->
      <%= form_with url: admin_meter_reading_export_path, method: :get, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :park, "Select Park", class: "block text-sm font-semibold text-[#17261f]" %>
          <%= f.collection_select :park_id, @parks, :id, :name, { include_blank: "Select a park" }, class: "mt-1 block w-full border rounded-lg p-2" %>
        </div>

        <div class="mb-4">
          <%= f.label :start_date, "Start Date", class: "block text-sm font-semibold text-[#17261f]" %>
          <%= f.date_field :start_date, value: Date.today - 1.month, class: "mt-1 block w-full border rounded-lg p-2" %>
        </div>

        <div class="mb-4">
          <%= f.label :end_date, "End Date", class: "block text-sm font-semibold text-[#17261f]" %>
          <%= f.date_field :end_date, value: Date.today, class: "mt-1 block w-full border rounded-lg p-2" %>
        </div>

        <div class="flex justify-end gap-3">
          <button
            type="button"
            data-action="click->modal#close"
            class="rounded border px-4 py-2 text-sm"
          >
            Cancel
          </button>

          <%= f.submit "Download CSV", class: "bg-[#ffb400] text-white py-2 px-4 rounded text-sm font-medium hover:bg-[#ffc029]" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Pitch Fees Export Modal -->
  <div
    id="pitch-fees-export-modal"
    data-modal
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4"
  >
    <div class="absolute inset-0" data-action="click->modal#close"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-lg p-6">
      <div class="flex justify-between items-start mb-3">
        <div>
          <h2 class="text-xl font-semibold text-[#17261f]">
            Pitch Fees Export
          </h2>
        </div>

        <button
          type="button"
          data-action="click->modal#close"
          class="w-8 h-8 flex items-center justify-center rounded hover:bg-[#f3f4f6]"
        >
          <span class="text-[#17261f80] text-lg leading-none">×</span>
        </button>
      </div>

      <!-- Meter Reading Export Form -->
      <%= form_with url: admin_pitch_fees_export_path, method: :get, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :park, "Select Park", class: "block text-sm font-semibold text-[#17261f]" %>
          <%= f.collection_select :park_id, @parks, :id, :name, { include_blank: "Select a park" }, class: "mt-1 block w-full border rounded-lg p-2" %>
        </div>

        <div class="mb-4">
          <%= f.label :year, "Start Date", class: "block text-sm font-semibold text-[#17261f]" %>

          <%# Fetch distinct years from PitchFee %>
          <% years = PitchFee.group(:year).order(year: :desc).pluck(:year) %>

          <%= f.select :year, options_for_select(years, Date.today.year), { prompt: "Select a year" }, class: "mt-1 block w-full border rounded-lg p-2" %>
        </div>

        <div class="flex justify-end gap-3">
          <button
            type="button"
            data-action="click->modal#close"
            class="rounded border px-4 py-2 text-sm"
          >
            Cancel
          </button>

          <%= f.submit "Download CSV", class: "bg-[#ffb400] text-white py-2 px-4 rounded text-sm font-medium hover:bg-[#ffc029]" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

